---
import NavBar from "@components/NavBar.astro";
import Projects from "@components/Projects.astro";
import Socials from "@components/Socials.astro";
import { Image } from "astro:assets";
import { Debug } from "astro/components";
import type Link from "@interfaces/Link";
import "../css/main.scss";
import blackCatWalking from "../assets/black_cat_walking_and_sleeping_like_my_child.gif";
import patheticCat from "../assets/pathetic.jpeg"
const points: Link[] = [
	{ displayName: "Home", location: "#" },
	{ displayName: "Projects", location: "#projects-sec" },
	{ displayName: "Socials", location: "#socials-sec" },
];
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<script
			src="https://kit.fontawesome.com/91e746a27a.js"
			crossorigin="anonymous"></script>
		<title>Ertan Taner</title>
		<script
			src="https://kit.fontawesome.com/91e746a27a.js"
			crossorigin="anonymous"></script>
		<link rel="icon" type="image/png" href="/favicon.png" />
	</head>
	<body>
		<header id="body-header">
			<NavBar points={points} />
		</header>
		<main>
			<h1>Who am I?</h1>
			<a
				href="https://tenor.com/view/cat-cute-animation-cartoon-hi-gif-16995078"
				target="_blank"
				class="cat-link"
				><Image
					src="https://media.tenor.com/aFrLlewBz4IAAAAi/cat-cute.gif"
					alt="An orange cat is waving at you"
					width={100}
					height={100}
					class="cat-gif"
				/>
			</a>
			<section id="who-am-i-sec" class="who-am-i-sec">
        <p>
        My name is Ertan, and I have been a professional software developer/engineer for over 2 years. I started my journey with C# as my first language, then learned about the basics of frontend. After I had finished with the basics for JavaScript frontend, I started to work on Node.js, mostly with TypeScript. With 2026, I have mastered the TypeScript and most of the Js ecosystem; improved my CI/CD knowledge.
        </p>
        <br />
			</section>
			<section id="projects-sec" class="projects-sec">
				<a
					href="https://www.artstation.com/artwork/X1vP1l"
					target="_blank"
					class="cat-link"
					><Image
						src={blackCatWalking}
						alt="Black cat walking and after that sleeping"
						width={150}
						height={150}
						class="cat-gif"
					/></a
				>
				<h2>Projects</h2>
				<Projects />
			</section>
			<section id="socials-sec" class="socials-sec">
				<a
          href="#socials-sec"
					target="_blank"
					class="cat-link"
				>
					<Image
            src={patheticCat}
						alt="a gray cat looking like a character from pathetic meme"
						width={300}
						height={300}
						class="cat-gif"
					/>
				</a>
				<Socials />
			</section>
		</main>
	</body>
</html>
<script>
	import "@utils/minizeMenu.ts";
	import "@utils/changeActiveStatus.ts"
</script>
