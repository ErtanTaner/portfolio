---
import smileyImg from "@assets/smileymeow-project-image.png";
import hubtofyImg from "@assets/hubtofy-project-portfolio.png";
import dictionareactImg from "@assets/dictionareact-project-portolifo.png";
import createRepo from "@assets/repo.png"
import fitness from "@assets/fitness.jpg"
import type Project from "@interfaces/Project";
import { Image } from "astro:assets";
const projects: Project[] = [
  {
    title: "SmileyMeow",
    href: "https://github.com/ErtanTaner/SmileyMeow",
    description: "SmileyMeow",
    imgAlt: "Login page of a vet clinic's website",
    image: smileyImg,
  },
  {
    title: "Create-repo",
    href: "https://gitlab.com/ErtanTaner/create-repo",
    description: "Create-repo",
    imgAlt: "",
    image: createRepo,
  },
  {
    title: "Gym-calendar",
    href: "https://github.com/ErtanTaner/gym_calendar",
    description: "Gym-calendar",
    imgAlt: "",
    image: fitness,
  },
  {
    title: "Hubtofy",
    href: "https://github.com/ErtanTaner/Hubtofy",
    description: "Hubtofy",
    imgAlt:
      "Pinky blush background with welcome message to user and navigation at the top",
    image: hubtofyImg,
  },
  {
    title: "Dictionareact",
    href: "https://github.com/ErtanTaner/dictionareact",
    description: "Dictionareact",
    imgAlt:
      "A website screen with a search bar and create button at the right of the screen.",
    image: dictionareactImg,
  },
];
---

<ol id="projects-list" class="projects-list">
  {
    projects.map((proj) => {
      return (
        <li>
          <a href={proj.href} target="_blank">
            <Image
              src={proj.image}
              alt={proj.imgAlt}
              width={320}
              height={150}
            />
          </a>
          <span>{proj.description}</span>
        </li>
      );
    })
  }
</ol>
